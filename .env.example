# Copy this file to `.env` and fill in your values.

# MongoDB connection URL (never expose this in frontend code)
MONGODB_URI=mongodb://localhost:27017/complaint_db

# Secret used to sign auth tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Port the server listens on
PORT=3000

# Super Admin seed account (created automatically on first start)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@123

# Set to "true" when deploying behind HTTPS
COOKIE_SECURE=false

# Create sample student + department accounts on first start (set false in production)
ENABLE_DEMO_ACCOUNTS=true

# Optional: comma-separated DNS servers to use for mongodb+srv lookups.
# Set this if your network's resolver cannot answer SRV queries.
# DNS_SERVERS=1.1.1.1,8.8.8.8
